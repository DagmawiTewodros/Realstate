{
  "name": "@platform/gym-api",
  "version": "1.0.0",
  "private": true,
  "description": "System B: gym management API (members, memberships, check-in, classes, messaging)",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc -p tsconfig.build.json && node dist/migrate.js",
    "db:seed": "tsc -p tsconfig.build.json && node dist/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@platform/nest-common": "workspace:*",
    "@platform/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "~0.44.7",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "~0.31.11",
    "supertest": "^7.1.0"
  }
}
