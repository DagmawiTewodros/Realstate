# Local development settings for the gym API. Copy to .env and adjust. Never commit .env.
# The API refuses to start if a required value is missing (see packages/nest-common/src/config.ts).
NODE_ENV=development
PORT=4001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gym_dev
SESSION_SECRET=change-me-at-least-32-characters-long
PUBLIC_WEB_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001
COOKIE_SECURE=false
TRUST_PROXY_HOPS=1

# Automation: direct | n8n | off
AUTOMATION_MODE=direct
N8N_WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=change-me-16-chars-or-more
INTERNAL_API_SECRET=change-me-16-chars-or-more
DISPATCHER_ENABLED=true
SCHEDULER_ENABLED=true

# Messaging (leave empty in development: messages are written to the log instead)
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
COMPANY_NAME=Gym

# File storage: local folder, or S3-compatible object storage
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Alerts (optional)
ERROR_WEBHOOK_URL=
ALERT_TELEGRAM_CHAT_ID=

# Only for the seed script
SEED_PASSWORD=change-me-10-chars
