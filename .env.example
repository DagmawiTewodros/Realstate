# docker-compose settings. Copy to .env and replace every "change-me" value.
# Generate secrets with:  openssl rand -base64 48
# Never commit the real .env file.

IMAGE_TAG=latest
ACME_EMAIL=it@example.com

# ---------- System A: property ----------
PROPERTY_DOMAIN=property.example.com
PROPERTY_DB_PASSWORD=change-me
PROPERTY_SESSION_SECRET=change-me-at-least-32-characters-long
PROPERTY_WEBHOOK_SIGNING_SECRET=change-me-16-chars-or-more
PROPERTY_INTERNAL_API_SECRET=change-me-16-chars-or-more
PROPERTY_COMPANY_NAME=Real estate
PROPERTY_SMTP_FROM=no-reply@property.example.com
# Only with AUTOMATION_MODE=n8n, for example https://n8n.example.com/webhook/property-events
PROPERTY_N8N_WEBHOOK_URL=

# ---------- System B: gym ----------
GYM_DOMAIN=gym.example.com
GYM_DB_PASSWORD=change-me
GYM_SESSION_SECRET=change-me-at-least-32-characters-long
GYM_WEBHOOK_SIGNING_SECRET=change-me-16-chars-or-more
GYM_INTERNAL_API_SECRET=change-me-16-chars-or-more
GYM_COMPANY_NAME=Gym
GYM_SMTP_FROM=no-reply@gym.example.com
GYM_N8N_WEBHOOK_URL=

# ---------- Shared ----------
# direct = messages are sent by the APIs; n8n = events go to n8n first (see docs/OPERATIONS.md); off = no messages.
AUTOMATION_MODE=direct
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Where errors and failed automation events are reported (optional).
ERROR_WEBHOOK_URL=
ALERT_TELEGRAM_CHAT_ID=
# Used only by `node dist/seed.js` to give the demo users a password.
SEED_PASSWORD=

# n8n (only with the "automation" profile)
N8N_DOMAIN=n8n.example.com
N8N_ENCRYPTION_KEY=change-me
